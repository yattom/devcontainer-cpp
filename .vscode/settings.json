{
  "cSpell.words": [
    "Anson",
    "bugprone",
    "clang",
    "cmake",
    "cpptools",
    "ctest",
    "devcontainer",
    "dpkg",
    "eamodio",
    "errorlens",
    "gitlens",
    "gmock",
    "googlemock",
    "googletest",
    "gtest",
    "htop",
    "liveshare",
    "localtime",
    "ninja",
    "noninteractive",
    "NOPASSWD",
    "procps",
    "stdexcept",
    "trainroute",
    "tzdata",
    "usermod",
    "usernamehw",
    "vscode",
    "vsliveshare",
    "yzhang",
    "zoneinfo"
  ],
  // CMake Tools
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": true,
  // C/C++ 拡張。compile_commands.json はビルド時に生成される
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  // 整形規則はリポジトリ直下の .clang-format に置いてある
  // 静的解析を有効にする。検査規則はリポジトリ直下の .clang-tidy に置いてある
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  // Editor: 保存時に整形する
  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  // ファイル整形の共通ルール（OS 差分による差分ノイズを防ぐ）
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  // Live Share でペアプロ中に見やすくする
  "editor.rulers": [
    100
  ]
}
