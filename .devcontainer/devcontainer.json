{
  "name": "CMake with C++ DevContainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "CMAKE_GENERATOR": "Ninja",
    "LANG": "ja_JP.UTF-8",
    "TZ": "Asia/Tokyo"
  },
  "customizations": {
    "vscode": {
      // バージョンは安定版（pre-release ではないもの）で固定する。
      // 拡張パック（ms-vscode.cpptools-extension-pack）を指定すると中身の
      // バージョンが固定されないため、中身を個別に並べている。
      // 変更するときは README の一覧も合わせること。
      "extensions": [
        // ========================================
        // Essential: C++ Development
        // ========================================
        "ms-vscode.cpptools@1.34.4",
        "ms-vscode.cmake-tools@1.24.42",

        // ========================================
        // Essential: Documentation
        // ========================================
        "yzhang.markdown-all-in-one@3.6.3",
        "DavidAnson.vscode-markdownlint@0.62.1",

        // ========================================
        // Essential: Code Quality
        // ========================================
        "streetsidesoftware.code-spell-checker@4.9.3",
        "usernamehw.errorlens@3.28.0",

        // ========================================
        // Recommended: Git
        // ========================================
        "eamodio.gitlens@19.2.0",

        // ========================================
        // Collaboration: Live Share
        // ========================================
        "MS-vsliveshare.vsliveshare@1.1.122"
      ],
      "settings": {
        // ========================================
        // Extensions
        // ========================================
        // 上でバージョンを固定しているので、自動更新で上書きさせない
        "extensions.autoUpdate": false,

        // ========================================
        // Live Share
        // ========================================
        // 安定版の機能セットのみを使う
        "liveshare.featureSet": "stable",
        // 参加者を都度承認してから接続させる
        "liveshare.guestApprovalRequired": true,
        "liveshare.anonymousGuestApproval": "prompt",
        "liveshare.connectionMode": "auto",
        // ステータスバーに Live Share の項目を常に表示する
        "liveshare.showInStatusBar": "always"
      }
    }
  },
  "forwardPorts": [],
  "postCreateCommand": "bash -c 'echo \"=== Environment Setup Verification ===\" && echo && echo \"=== Compiler ===\" && g++ --version | head -1 && echo && echo \"=== CMake / Ninja ===\" && cmake --version | head -1 && ninja --version && echo && echo \"=== Timezone ===\" && date && echo && echo \"=== Locale ===\" && locale && echo && echo \"=== Configure & Build ===\" && cmake -S . -B build && cmake --build build'"
}
